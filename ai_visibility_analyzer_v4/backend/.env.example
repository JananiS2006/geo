# Copy this file to .env (same folder) and fill in the keys you have.
# Any assistant without a key falls back to clearly labelled simulated answers.

OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Which model writes recommendations and blog articles: openai | gemini | anthropic
WRITER_PROVIDER=gemini

# Optional model overrides (check each provider's docs for current names)
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash      # model for Gemini's answers in the analysis
# GEMINI_ENDPOINT=ai_studio           # or vertex; auto-detected if unset
# WRITER_WORKERS=2                    # sections written in parallel (keep low on free tiers)
# PERPLEXITY_MODEL=sonar
# CLAUDE_MODEL=claude-haiku-5-5
# WRITER_MODEL=gemini-2.5-pro         # blog writer model; falls back automatically if unavailable
